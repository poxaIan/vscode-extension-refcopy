{
  "name": "refcopy",
  "displayName": "RefCopy",
  "description": "Copy @file (line-range) reference to clipboard",
  "version": "0.0.1",
  "publisher": "poxaIan",
  "repository": {
    "type": "git",
    "url": "https://github.com/poxaIan/vscode-extension-refcopy.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "refcopy.copy",
        "title": "RefCopy: Copy reference"
      }
    ],
    "keybindings": [
      {
        "command": "refcopy.copy",
        "key": "ctrl+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
